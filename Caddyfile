# RouteLogs static site — served by Caddy on Railway.
# Railway terminates TLS at the edge and injects $PORT; Caddy serves plain
# HTTP on that port and sets the security/cache headers below.

{
	admin off
	auto_https off
	persist_config off
}

# Security headers — imported into both the main route and the error handler
# so they cover normal responses AND the custom 404.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://*.calendly.com; font-src 'self' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; script-src 'self' https://assets.calendly.com; frame-src https://calendly.com; connect-src 'self' https://*.calendly.com; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), xr-spatial-tracking=(), browsing-topics=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security_headers

	# --- Caching ---
	# Content-hashed assets + fonts never change under a given name → immutable.
	@immutable path /styles-*.css /app-*.js /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Brand images / manifest / crawl files → cache a day, revalidate after.
	@media path *.png *.svg *.ico /site.webmanifest /robots.txt /sitemap.xml
	header @media Cache-Control "public, max-age=86400"
	# HTML → always revalidate so deploys are picked up immediately (ETag does the rest).
	@html path / *.html /privacy /terms
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# --- Clean URLs: /privacy → privacy.html ---
	try_files {path} {path}.html {path}/index.html
	file_server

	# --- Branded 404 (with security headers and the real 404 status) ---
	handle_errors {
		import security_headers
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}
